                            print_platform(concat_str("clint<8>[", concat_str(bits_str(addr), concat_str("] <- ", concat_str(bits_str(data), " (mtime)")))));
                        mtime = data;
                        clint_dispatch();
                        (temp_XT_1, temp_XT_2, temp_XT_3) = (Ok, TRUE, ExceptionType UNKNOWN);
