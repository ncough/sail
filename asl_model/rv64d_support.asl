                                constant AccessType XM_match_415 = t;
                                if XM_match_415 == InstructionFetch then
                                    (temp_XT_1, temp_XT_2, temp_XT_3) = (Err, bits((8) * (width)) UNKNOWN, E_Fetch_Access_Fault);
                                elsif XM_match_415 == Read then
