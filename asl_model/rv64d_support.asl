                            mtime = update_subrange_bits(mtime, 31, 0, data);
                            clint_dispatch();
                            (temp_XT_1, temp_XT_2, temp_XT_3) = (Ok, TRUE, ExceptionType UNKNOWN);
                        else
                            if and_bool(eq_bits(addr, MTIME_BASE_HI), eq_int(width, 4)) then
